<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NoActionBar: 画面ごとに Toolbar を明示的に置く（iOS 版がシステムの UINavigationBar を隠し、
         画面ごとにカスタムの上部バーを描画しているのに合わせる）。
         minSdk 26（API21以上）なので、ライブラリ由来ではなくフレームワーク純正の
         android:colorPrimary 等を使う（サードパーティ AAR のカスタム属性を使わない構成にするため）。 -->
    <style name="Theme.AndroidPoc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorPrimary">@color/nav_bar</item>
        <item name="android:colorPrimaryDark">@color/nav_bar</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <!-- Todo一覧・確認1・確認2・完了・ログインで共通の、teal背景+白文字中央寄せタイトルの
         カスタムツールバー用スタイル。 -->
    <style name="CustomToolbarTitle">
        <item name="android:textColor">@color/nav_bar_title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
